OLLAMA_BASE_URL=http://127.0.0.1:11434
SECOND_BRAIN_MODEL=qwen2.5:7b
SECOND_BRAIN_EMBEDDING_MODEL=bge-m3
# Empty: operating system timezone.
SECOND_BRAIN_TIMEZONE=
# Empty: per-user application data (%LOCALAPPDATA%\SecondBrain).
SECOND_BRAIN_DATA_DIR=
SECOND_BRAIN_MODEL_TIMEOUT=120
SECOND_BRAIN_RUN_TIMEOUT=300
SECOND_BRAIN_MAX_TOOLS=20
# Model context (num_ctx). 16384 recommended with integrations; uses more VRAM.
SECOND_BRAIN_CONTEXT_WINDOW=8192
SECOND_BRAIN_VOICE_MODEL=small
SECOND_BRAIN_VOICE_LANGUAGE=es
